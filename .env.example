# Copy to .env and fill in. .env is git-ignored and excluded from the Docker images.

# Benchmark container (Sketchfab download, reproduce / generate-model)
SKETCHFAB_API_TOKEN=
TRIPO_API_KEY=
MESHY_API_KEY=

# Agent benchmark (python -m src.agentbench): model API used by the example configs.
# OpenAI-compatible endpoint (benchmarks/example/mcp_blender.json):
# LLM_API_FORMAT: openai (/chat/completions, default) or openai_responses (OpenAI /responses)
LLM_API_FORMAT=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Claude (benchmarks/example/builtin_python.json):
ANTHROPIC_API_KEY=

# Codex CLI (benchmarks/example/command_codex.json). The benchmark image ships
# the codex binary and generates ~/.codex/config.toml from these variables.
# Official OpenAI API:
OPENAI_API_KEY=
CODEX_MODEL=gpt-5-codex
# OpenRouter (or any OpenAI-compatible gateway) instead: set these and put the
# key in OPENROUTER_API_KEY (or change CODEX_ENV_KEY to whatever variable you use).
# CODEX_PROVIDER=openrouter
# CODEX_BASE_URL=https://openrouter.ai/api/v1
# CODEX_ENV_KEY=OPENROUTER_API_KEY
# CODEX_WIRE_API=chat
# OPENROUTER_API_KEY=

# Blender MCP container (optional asset integrations inside Blender).
# SKETCHFAB_API_TOKEN above is reused for the Blender addon automatically.
BLENDERMCP_HYPER3D_API_KEY=
BLENDERMCP_POLYPIZZA_API_KEY=
